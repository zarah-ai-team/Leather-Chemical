// LeatherChem TMS — production schema
// Multi-tenant: every business table carries organizationId.
// Money: Decimal(14,2) INR. Convert to number at the service boundary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (Better Auth managed tables) + tenancy
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  activities    ActivityEvent[]
  auditLogs     AuditLog[]
  assignedCustomers Customer[] @relation("AssignedSalesperson")
  quotationsCreated Quotation[] @relation("QuotationCreatedBy")
  stageEvents   OrderStageEvent[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  gstin     String?
  createdAt DateTime @default(now())

  memberships   Membership[]
  customers     Customer[]
  suppliers     Supplier[]
  products      Product[]
  quotations    Quotation[]
  orders        Order[]
  documents     Document[]
  activities    ActivityEvent[]
  auditLogs     AuditLog[]
  warehouses    Warehouse[]
  stockItems    StockItem[]
  stockMovements StockMovement[]
  sequences     NumberSequence[]
}

enum Role {
  SUPER_ADMIN
  OWNER
  SALES_MANAGER
  SALES_EXECUTIVE
  ACCOUNTS
  PURCHASE
  WAREHOUSE
  OPERATIONS
  SUPPORT
  MANAGEMENT
  AUDITOR
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// Per-org human-readable number sequences (QUO-2026, ORD-2026, ...)
model NumberSequence {
  id             String       @id @default(cuid())
  organizationId String
  key            String // e.g. "QUO-2026"
  next           Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

enum ProductCategory {
  FATLIQUORS
  PIGMENTS
  DYES
  WAXES
  BINDERS
  FINISHING_CHEMICALS
  RETANNING_CHEMICALS
}

model Customer {
  id                  String            @id @default(cuid())
  organizationId      String
  companyName         String
  gstin               String?
  pan                 String?
  industry            String?
  country             String
  address             String?
  creditLimit         Decimal           @default(0) @db.Decimal(14, 2)
  paymentTerms        String?
  preferredCategories ProductCategory[]
  annualPurchaseValue Decimal           @default(0) @db.Decimal(14, 2)
  assignedToId        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?           @relation("AssignedSalesperson", fields: [assignedToId], references: [id], onDelete: SetNull)
  contacts     Contact[]
  activities   ActivityEvent[]
  quotations   Quotation[]
  orders       Order[]
  documents    Document[]

  @@index([organizationId, companyName])
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  designation String?
  email      String?
  phone      String?
  whatsapp   String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  FOLLOWUP
  WHATSAPP
}

model ActivityEvent {
  id             String       @id @default(cuid())
  organizationId String
  customerId     String
  userId         String?
  type           ActivityType
  date           DateTime
  summary        String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([customerId, date])
  @@index([organizationId, type, date])
}

// ---------------------------------------------------------------------------
// Suppliers & products
// ---------------------------------------------------------------------------

model Supplier {
  id               String  @id @default(cuid())
  organizationId   String
  name             String
  country          String
  contactPerson    String?
  email            String?
  phone            String?
  avgDeliveryDays  Int     @default(0)
  qualityRating    Decimal @default(0) @db.Decimal(3, 1) // 0.0 - 5.0
  reliabilityScore Int     @default(0) // 0 - 100 on-time %
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       SupplierProduct[]
  prices         SupplierPrice[]

  @@index([organizationId, name])
}

model Product {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  category       ProductCategory
  unit           String          @default("kg")
  hsnCode        String?
  purchaseCost   Decimal         @db.Decimal(14, 2)
  sellingPrice   Decimal         @db.Decimal(14, 2)
  technicalSheet String?
  msds           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  suppliers      SupplierProduct[]
  supplierPrices SupplierPrice[]
  priceHistory   ProductPrice[]
  quotationLines QuotationLine[]
  orderLines     OrderLine[]
  documents      Document[]
  stockItems     StockItem[]
  stockMovements StockMovement[]

  @@index([organizationId, category])
}

// M:N supplier <-> product, with primary-supplier flag
model SupplierProduct {
  id           String  @id @default(cuid())
  supplierId   String
  productId    String
  isPrimary    Boolean @default(false)
  moq          Decimal? @db.Decimal(14, 2)
  leadTimeDays Int?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([productId])
}

// Supplier's quoted purchase price over time
model SupplierPrice {
  id         String   @id @default(cuid())
  supplierId String
  productId  String
  date       DateTime
  price      Decimal  @db.Decimal(14, 2)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, date])
  @@index([supplierId, productId])
}

// Our own cost / sell price history
model ProductPrice {
  id           String   @id @default(cuid())
  productId    String
  date         DateTime
  purchaseCost Decimal  @db.Decimal(14, 2)
  sellingPrice Decimal  @db.Decimal(14, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, date])
}

// ---------------------------------------------------------------------------
// Quotations & orders
// ---------------------------------------------------------------------------

enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
}

model Quotation {
  id             String          @id @default(cuid())
  organizationId String
  number         String
  customerId     String
  status         QuotationStatus @default(DRAFT)
  validUntil     DateTime?
  notes          String?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User?           @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines        QuotationLine[]
  orders       Order[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([customerId])
}

model QuotationLine {
  id          String  @id @default(cuid())
  quotationId String
  productId   String
  qty         Decimal @db.Decimal(14, 2)
  unitPrice   Decimal @db.Decimal(14, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  taxPct      Decimal @default(18) @db.Decimal(5, 2) // GST

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quotationId])
}

enum OrderStage {
  INQUIRY_RECEIVED
  SUPPLIER_CONFIRMED
  QUOTATION_SENT
  PO_RECEIVED
  SUPPLIER_ORDERED
  DISPATCHED
  DELIVERED
  PAYMENT_RECEIVED
}

model Order {
  id               String     @id @default(cuid())
  organizationId   String
  number           String
  customerId       String
  quotationId      String?
  stage            OrderStage @default(INQUIRY_RECEIVED)
  expectedDelivery DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation    Quotation?        @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  lines        OrderLine[]
  stageEvents  OrderStageEvent[]

  @@unique([organizationId, number])
  @@index([organizationId, stage])
  @@index([customerId])
}

// Snapshotted from the quotation at conversion time (no shared references)
model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  qty       Decimal @db.Decimal(14, 2)
  unitPrice Decimal @db.Decimal(14, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// Full transition history behind the Kanban
model OrderStageEvent {
  id          String      @id @default(cuid())
  orderId     String
  fromStage   OrderStage?
  toStage     OrderStage
  changedById String?
  changedAt   DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, changedAt])
}

// ---------------------------------------------------------------------------
// Inventory (foundation — expanded in later phases)
// ---------------------------------------------------------------------------

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  location       String?
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockItems   StockItem[]
  movements    StockMovement[]

  @@index([organizationId])
}

model StockItem {
  id             String   @id @default(cuid())
  organizationId String
  warehouseId    String
  productId      String
  batchNo        String?
  qty            Decimal  @default(0) @db.Decimal(14, 2)
  reorderLevel   Decimal? @db.Decimal(14, 2)
  expiryDate     DateTime?
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, batchNo])
  @@index([organizationId, productId])
}

enum StockMovementType {
  IN
  OUT
  RETURN
  ADJUSTMENT
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  warehouseId    String
  productId      String
  type           StockMovementType
  qty            Decimal           @db.Decimal(14, 2)
  date           DateTime          @default(now())
  refType        String? // "order" | "purchase" | ...
  refId          String?
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId, productId, date])
}

// ---------------------------------------------------------------------------
// Documents & audit
// ---------------------------------------------------------------------------

enum DocumentType {
  MSDS
  TECHNICAL_SHEET
  CATALOG
  QUOTATION
  INVOICE
  PRICE_LIST
  CONTRACT
  CERTIFICATE
  OTHER
}

model Document {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  type           DocumentType
  productId      String?
  customerId     String?
  // Phase 1: text content searched by the assistant. Later: fileUrl -> S3, chunks -> pgvector.
  content        String?
  fileUrl        String?
  mimeType       String?
  uploadedAt     DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, type])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String // "create" | "update" | "delete" | "stage_change" | "login" | ...
  module         String // "customers" | "orders" | ...
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}
